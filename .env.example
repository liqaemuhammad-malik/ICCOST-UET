# ==============================================================================
# ICOSST 2026 Platform - Environment Configuration (.env)
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB 6+)
# Option A: Local replica set or standalone MongoDB (e.g., mongodb://localhost:27017/icosst2026?replicaSet=rs0 or without replica set)
# Option B: MongoDB Atlas URI: mongodb+srv://<user>:<password>@cluster.mongodb.net/icosst2026
# Option C: Leave empty or 'memory' to auto-launch built-in MongoDB Memory Server
MONGODB_URI=mongodb://127.0.0.1:27017/icosst2026

# Redis & Background Workers
# If Redis is unavailable, the system automatically falls back to the robust In-Memory Queue adapter
REDIS_URL=redis://127.0.0.1:6379
USE_IN_MEMORY_QUEUE=true

# Authentication & Cryptography
JWT_ACCESS_SECRET=icosst2026_super_secure_jwt_access_secret_key_98234710293847
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=icosst2026_super_secure_jwt_refresh_secret_key_84920381029384
JWT_REFRESH_EXPIRES_IN=7d
QR_SIGNING_SECRET=icosst2026_qr_cryptographic_signing_secret_key_77192830192837
COOKIE_SECRET=icosst2026_secure_cookie_signing_secret_99283719203847

# Email / SMTP Configuration (MailHog or standard SMTP)
# Dev default: SMTP mock / logger or MailHog at localhost:1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ICOSST 2026 Secretariat <icosst@kics.edu.pk>"

# File Uploads (Bank payment proofs, abstract documents)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Payment Gateway Configuration (Sample / Mock)
MOCK_GATEWAY_WEBHOOK_SECRET=icosst2026_mock_gateway_webhook_secret_key_5544332211
